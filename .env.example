# Variables de la stack OnAir-Desk (à saisir dans Portainer, ou à copier en .env).
# Seul RADIODJ_DB_PASSWORD est secret : ne jamais en mettre de vraie valeur dans ce fichier.

# Adresse(s) d'accès à l'outil, séparées par des virgules. La première est l'adresse principale.
# Obligatoire. Toute adresse utilisée par l'afficheur ou les postes doit figurer ici.
PUBLIC_ORIGIN=https://onair-desk.lan,https://192.168.1.20

# Noms DNS et adresses IP inscrits dans le certificat HTTPS généré.
# Facultatif : par défaut, ceux de PUBLIC_ORIGIN.
TLS_HOSTNAMES=

# Port publié sur la machine hôte (443 = https://adresse sans numéro de port).
HOST_PORT=443

# Fuseau horaire du conteneur (l'heure affichée suit le paramètre de la station).
TZ=Europe/Paris

# Niveau de logs : fatal, error, warn, info, debug, trace.
LOG_LEVEL=info

# ---- RadioDJ (facultatif, source d'automation « RadioDJ ») ------------------------------

# Mot de passe du compte MariaDB de RadioDJ, avec le seul droit SELECT (secret).
# Hôte, port, base et utilisateur se règlent dans Administration > Paramètres.
RADIODJ_DB_PASSWORD=

# Port HTTP dédié aux connecteurs, pour le signal du plugin « Metadata Export » de RadioDJ
# (qui refuse le certificat HTTPS interne). Vide : écoute fermée (défaut).
# Réseau interne uniquement : il n'expose que la route du signal, protégée par jeton.
CONNECTOR_HTTP_PORT=

# Adresse de la Debian sur laquelle publier ce port. Par défaut 127.0.0.1 : injoignable depuis
# le réseau. Mettre l'adresse IP de la Debian sur le réseau du studio (ex. 192.168.1.20).
CONNECTOR_BIND=127.0.0.1
